{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-bpl-studio.example/schemas/decision-request.json",
  "title": "Studio DecisionRequest — contrato proposto",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseId", "bindingId", "correlationId", "input"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "releaseId": {"type": "string", "minLength": 1, "maxLength": 128},
    "bindingId": {"type": "string", "minLength": 1, "maxLength": 128},
    "correlationId": {"type": "string", "minLength": 1, "maxLength": 128},
    "input": {"type": "object", "maxProperties": 40}
  }
}
